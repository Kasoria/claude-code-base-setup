# ============================================================
# KASORIA BASE SETUP — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to Git.
# ============================================================

# ------ Contact Form: Option A — SMTP (recommended) --------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
CONTACT_TO=your@email.com

# ------ Contact Form: Option B — Resend ---------------------
# (Uncomment in app/api/contact/route.ts if you prefer Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# CONTACT_TO=your@email.com

# ------ Cookie Consent Banner (optional) --------------------
# Set to true if you activated the cookie banner in layout.tsx.
# This shows a "Cookie Preferences" link in the footer.
# NEXT_PUBLIC_COOKIE_CONSENT=true
